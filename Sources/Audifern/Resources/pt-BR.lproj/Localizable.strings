"Microphone, streaming and tinnitus controls" = "Controles de microfone, streaming e zumbido";
"Edit equalizers" = "Editar equalizadores";
"Refresh %@ EQ" = "Atualizar EQ %@";
"Expand volume controls" = "Expandir controles de volume";
"Compact volume controls" = "Recolher controles de volume";
"Details…" = "Detalhes…";
